Subject: [PATCH] Link zstd through whichever target the config exports

The fork moved zstd linking out of cmake/CMakeLists.txt's
IFCOPENSHELL_RocksDB interface target -- which is what conda-forge's
Update_ZSTD_linking_logic.patch fixed -- into the two consumers, and
both hard-code zstd::libzstd_static. conda-forge's zstd exports
zstd::libzstd_shared and ZSTD::ZSTD, so CMake's generate step fails
with "Target IfcParse links to zstd::libzstd_static but the target was
not found" as soon as WITH_ROCKSDB and WITH_ZSTD are on.

Same generator expression conda-forge settled on upstream, so the
static target still wins where it exists and a shared-only config
resolves too.
---
diff --git a/src/ifcparse/CMakeLists.txt b/src/ifcparse/CMakeLists.txt
index d665f91ab4..250cfd6123 100644
--- a/src/ifcparse/CMakeLists.txt
+++ b/src/ifcparse/CMakeLists.txt
@@ -67,7 +67,7 @@ endif()
 if(WITH_ROCKSDB)
     target_link_libraries(IfcParse ${IFCOPENSHELL_ROCKSDB_TARGET})
     if(WITH_ZSTD)
-        target_link_libraries(IfcParse zstd::libzstd_static)
+        target_link_libraries(IfcParse $<IF:$<TARGET_EXISTS:ZSTD::ZSTD>,ZSTD::ZSTD,$<IF:$<TARGET_EXISTS:zstd::libzstd_static>,zstd::libzstd_static,$<IF:$<TARGET_EXISTS:zstd::libzstd_shared>,zstd::libzstd_shared,zstd>>>)
     endif()
 endif()
 
diff --git a/src/ifcviewer/CMakeLists.txt b/src/ifcviewer/CMakeLists.txt
index 897f19d35a..fc55055ac5 100644
--- a/src/ifcviewer/CMakeLists.txt
+++ b/src/ifcviewer/CMakeLists.txt
@@ -247,7 +247,7 @@ if(EMSCRIPTEN)
     target_include_directories(IfcViewerCore PRIVATE ${ZSTD_DEC_DIR})
 else()
     find_package(zstd CONFIG REQUIRED)
-    target_link_libraries(IfcViewerCore PUBLIC zstd::libzstd_static)
+    target_link_libraries(IfcViewerCore PUBLIC $<IF:$<TARGET_EXISTS:ZSTD::ZSTD>,ZSTD::ZSTD,$<IF:$<TARGET_EXISTS:zstd::libzstd_static>,zstd::libzstd_static,$<IF:$<TARGET_EXISTS:zstd::libzstd_shared>,zstd::libzstd_shared,zstd>>>)
 endif()
 install(TARGETS IfcViewerCore EXPORT ${IFCOPENSHELL_EXPORT_TARGETS})
 
